{
  "name": "@uploadcare/api-clients",
  "private": true,
  "type": "module",
  "version": "6.24.0",
  "license": "MIT",
  "workspaces": [
    "packages/api-client-utils",
    "packages/api-emulator",
    "packages/cname-prefix",
    "packages/signed-uploads",
    "packages/upload-client",
    "packages/rest-client",
    "packages/image-shrink",
    "packages/quality-insights",
    "packages/cdn-url"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build:docs:upload-client": "typedoc --out docs/upload-client packages/upload-client/src/index.ts --readme packages/upload-client/README.md --options ./typedoc.json",
    "build:docs:rest-client": "typedoc --out docs/rest-client packages/rest-client/src/index.ts --readme packages/rest-client/README.md  --options ./typedoc.json",
    "build:docs:signed-uploads": "typedoc --out docs/signed-uploads packages/signed-uploads/src/index.ts --readme packages/signed-uploads/README.md  --options ./typedoc.json",
    "build:docs:image-shrink": "typedoc --out docs/image-shrink packages/image-shrink/src/index.ts --readme packages/image-shrink/README.md  --options ./typedoc.json",
    "build:docs": "rimraf docs && run-s build:docs:* && touch docs/.nojekyll",
    "build": "npm run build --workspaces --if-present",
    "lint": "run-s eslint prettier",
    "lint:fix": "run-s eslint:fix prettier:fix",
    "eslint:fix": "eslint ./ --ext=ts,js --fix",
    "eslint": "eslint ./ --ext=ts,js",
    "prettier:fix": "prettier --write './**/*.{ts,js}'",
    "prettier": "prettier --check './**/*.{ts,js}'",
    "test": "npm run test --workspaces --if-present",
    "test:production": "npm run test:production --workspaces --if-present",
    "release:prepare": "shipjs prepare",
    "prepare": "husky install",
    "build:docs:cdn-url": "npm run docs:build -w @uploadcare/cdn-url && mkdir -p docs && cp -r packages/cdn-url/docs/.vitepress/dist docs/cdn-url"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chalk": "4.1.2",
    "dotenv": "^16.0.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^13.0.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.2.5",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-jsdoc": "^1.3.0",
    "rimraf": "3.0.2",
    "rollup": "^4.65.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "shipjs": "0.28.4",
    "tslib": "^2.4.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/markdown-it": "13.0.9",
    "@types/linkify-it": "3.0.5",
    "@types/mdurl": "1.0.5",
    "serialize-javascript": "^7.1.4",
    "vitepress": {
      "vite": "^7.3.7"
    }
  }
}
