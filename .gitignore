node_modules
dist
.env
docs
**/coverage/**

# cdn-url docs: keep the source, ignore generated artifacts
!packages/cdn-url/docs/
packages/cdn-url/docs/reference/
packages/cdn-url/docs/.vitepress/dist/
packages/cdn-url/docs/.vitepress/cache/

# firebase (docs deploy is staged outside the repo)
firebase.json
.firebaserc
.firebase/

# npm workspaces resolve from the root lockfile; a per-package one is never read
# and goes stale, which security scanners then report.
packages/*/package-lock.json

# Vitest 5 run artifacts
.vitest/
