{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest"],
    "noUncheckedIndexedAccess": true,
    // `scripts/*.ts` run directly via `node`, which has no bundler-style
    // extensionless/`.js`-for-`.ts` resolution, so they import each other
    // with the real `.ts` extension.
    "allowImportingTsExtensions": true,
    // Restated rather than left to inherit: oxlint's tsconfig resolver reads
    // this file directly and doesn't follow `extends` for it, so the
    // `./foo.js` specifiers pointing at `foo.ts` source (this package's whole
    // export surface) read as unresolved without it.
    "moduleResolution": "bundler"
  },
  "include": ["src", "test", "scripts"]
}
