{
  "name": "@uploadcare/signed-uploads",
  "version": "6.20.0",
  "description": "@uploadcare/signed-uploads secures uploads to Uploadcare. On the server it mints the credentials the Upload API expects: JWTs for the `Authorization: Bearer` scheme, with optional endpoint scope and operation limits, and the legacy {secureSignature, secureExpire} pair. In the browser, @uploadcare/signed-uploads/client caches a token and replaces it before it expires. Zero dependencies, full TypeScript support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE ./LICENSE",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prebuild": "npm run clean",
    "build": "tsc && vite build",
    "postbuild": "npm run smoke:dist && npm run check:exports && npm run lint:size",
    "check:exports": "attw --pack . && publint --strict",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "lint:size": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uploadcare/uploadcare-js-api-clients.git"
  },
  "author": "Uploadcare",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/uploadcare/uploadcare-js-api-clients/issues"
  },
  "homepage": "https://github.com/uploadcare/uploadcare-js-api-clients#readme",
  "keywords": [
    "uploadcare",
    "signed-uploads",
    "signature",
    "security",
    "authentication",
    "jwt",
    "bearer",
    "hmac",
    "typescript",
    "nodejs"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/preset-small-lib": "^12.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "publint": "^0.3.12",
    "size-limit": "^12.1.0",
    "terser": "^5.51.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "size-limit": [
    {
      "name": "client entry (ships to browsers)",
      "path": "dist/client.js",
      "limit": "600 B"
    },
    {
      "name": "AuthTokenCache alone",
      "path": "dist/client.js",
      "import": "{ AuthTokenCache }",
      "limit": "520 B"
    },
    {
      "name": "server entry",
      "path": "dist/server.js",
      "ignore": [
        "node:crypto"
      ],
      "limit": "1.1 KB"
    }
  ]
}
