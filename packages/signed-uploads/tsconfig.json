{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest"],
    "noUncheckedIndexedAccess": true
  },
  // `vite.config.ts` is deliberately out: `vite-plugin-dts` ships declarations
  // that reference `typescript` namespace members TypeScript 7 no longer
  // exposes, and it is build tooling rather than shipped code.
  "include": ["src"]
}
